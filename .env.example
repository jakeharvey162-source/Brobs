# Set these in your shell; the standard-library app does not auto-load .env files.
OANDA_PRACTICE_TOKEN=YOUR_PRACTICE_TOKEN
OANDA_PRACTICE_ACCOUNT=YOUR_PRACTICE_ACCOUNT_ID

# Stock-data access with eligible Alpaca paper credentials; never paste in Pine.
ALPACA_PAPER_KEY=YOUR_LOCAL_PAPER_KEY
ALPACA_PAPER_SECRET=YOUR_LOCAL_PAPER_SECRET
# Crypto public-data requests need no API key.
