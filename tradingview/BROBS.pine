//@version=6
//@strategy_alert_message {{strategy.order.alert_message}}
strategy("BROBS Multi-Market Paper", overlay=true, initial_capital=10000, currency=currency.NONE, pyramiding=0, margin_long=100, margin_short=100, commission_type=strategy.commission.percent, commission_value=0.1, slippage=5, calc_on_every_tick=false, process_orders_on_close=false)
// Paper research only. No established 70-80% win rate.
// Account currency follows chart quote currency; each chart is a separate account.
// Set feed-specific costs in Properties. Default 0.1% commission suits a crypto example.
family = input.string("Trend momentum", "Strategy family", options=["Trend momentum", "RSI pullback", "RSI2 reversion", "Donchian breakout"])
riskFraction = input.float(0.5, "Risk budget (%)", minval=0.1, maxval=2.0) / 100
autoStop = input.bool(true, "Use market default stop (forex 0.5%, stocks/crypto 2%)")
manualStop = input.float(2.0, "Custom stop (%)", minval=0.1, maxval=10.0) / 100
rewardRisk = input.float(2.0, "Target / stop", minval=1.0, maxval=5.0)
notionalFraction = input.float(20.0, "Maximum notional / equity (%)", minval=1.0, maxval=25.0) / 100
rsi2Threshold = input.float(10.0, "RSI2 entry threshold", minval=1.0, maxval=30.0)
rsi14Threshold = input.float(40.0, "RSI14 pullback threshold", minval=20.0, maxval=45.0)
startDate = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Start date")
endDate = input.time(timestamp("01 Jan 2030 00:00 +0000"), "End date")
strategy.risk.max_intraday_loss(2, strategy.percent_of_equity)
strategy.risk.max_drawdown(10, strategy.percent_of_equity)

isForex = syminfo.type == "forex"
isStock = syminfo.type == "stock" or syminfo.type == "fund"
isCrypto = syminfo.type == "crypto"
quoteSupported = syminfo.currency == "USD" or (isCrypto and syminfo.currency == "USDT")
supported = (isForex or isStock or isCrypto) and quoteSupported
// No borrowed stock/crypto positions; only forex simulation can go short.
allowShort = isForex and syminfo.currency == "USD"
stopFraction = autoStop ? (isForex ? 0.005 : 0.02) : manualStop
inWindow = time >= startDate and time < endDate
fast = ta.sma(close, 8)
slow = ta.sma(close, 21)
regime = ta.sma(close, 100)
exitMean = ta.sma(close, 5)
momentum = close / close[5] - 1
volatility = ta.stdev(close / close[1] - 1, 20, true)
threshold = math.max(0.0002, volatility * 0.5)
rsi2 = ta.rsi(close, 2)
rsi14 = ta.rsi(close, 14)
upper = ta.highest(high[1], 20)
lower = ta.lowest(low[1], 20)
exitLower = ta.lowest(low[1], 10)
exitUpper = ta.highest(high[1], 10)
ready = bar_index >= 99 and not na(regime) and not na(volatility)
longSignal = ready and fast > slow * 1.0001 and momentum > threshold and volatility <= 0.015
shortSignal = ready and fast < slow * 0.9999 and momentum < -threshold and volatility <= 0.015
exitLong = shortSignal
exitShort = longSignal
if family == "RSI2 reversion"
    longSignal := ready and close > regime and rsi2 < rsi2Threshold
    shortSignal := ready and close < regime and rsi2 > 100 - rsi2Threshold
    exitLong := ready and (close >= exitMean or rsi2 >= 70)
    exitShort := ready and (close <= exitMean or rsi2 <= 30)
else if family == "RSI pullback"
    longSignal := ready and close > regime and rsi14 < rsi14Threshold
    shortSignal := ready and close < regime and rsi14 > 100 - rsi14Threshold
    exitLong := ready and (rsi14 >= 65 or close < regime)
    exitShort := ready and (rsi14 <= 35 or close > regime)
else if family == "Donchian breakout"
    longSignal := ready and close > upper and close > regime
    shortSignal := ready and close < lower and close < regime
    exitLong := ready and close < exitLower
    exitShort := ready and close > exitUpper

lossTicks = math.max(1, math.round(close * stopFraction / syminfo.mintick))
targetTicks = math.max(1, math.round(lossTicks * rewardRisk))
riskPerUnit = lossTicks * syminfo.mintick * syminfo.pointvalue
rawQuantity = math.min(strategy.equity * riskFraction / riskPerUnit, strategy.equity * notionalFraction / (close * syminfo.pointvalue))
quantity = isCrypto ? math.floor(rawQuantity * 1000000) / 1000000 : math.floor(rawQuantity)
message(action, reason) =>
    '{"app":"BROBS","symbol":"' + syminfo.tickerid + '","quote_currency":"' + syminfo.currency + '","timeframe":"' + timeframe.period + '","signal_time":' + str.tostring(time_close) + ',"action":"' + action + '","reason":"' + reason + '","paper_only":true}'

if barstate.isconfirmed
    if not inWindow
        strategy.cancel_all()
        strategy.close_all(alert_message=message("close", "outside_test_window"))
    else if supported
        if strategy.position_size > 0 and exitLong
            strategy.close("Long", alert_message=message("close_long", "strategy_exit"))
        else if strategy.position_size < 0 and exitShort
            strategy.close("Short", alert_message=message("close_short", "strategy_exit"))
        else if strategy.position_size == 0 and quantity > 0
            if longSignal
                strategy.entry("Long", strategy.long, qty=quantity, alert_message=message("buy", "closed_bar_setup"))
                strategy.exit("Long bracket", "Long", loss=lossTicks, profit=targetTicks, alert_message=message("close_long", "stop_or_target"))
            else if allowShort and shortSignal
                strategy.entry("Short", strategy.short, qty=quantity, alert_message=message("sell", "closed_bar_setup"))
                strategy.exit("Short bracket", "Short", loss=lossTicks, profit=targetTicks, alert_message=message("close_short", "stop_or_target"))
plot(fast, "Fast 8", color=color.teal)
plot(slow, "Slow 21", color=color.orange)
plot(family == "Trend momentum" ? na : regime, "Regime 100", color=color.gray)
plotshape(supported and inWindow and barstate.isconfirmed and longSignal, title="Buy setup (not a fill)", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
plotshape(supported and inWindow and barstate.isconfirmed and shortSignal, title="Sell / exit setup (not a fill)", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.tiny)
var table info = table.new(position.top_right, 1, 2)
if barstate.islast
    table.cell(info, 0, 0, supported ? "BROBS PAPER | " + syminfo.currency + " | " + family : "Use USD forex/stocks or USD/USDT crypto", text_color=supported ? color.white : color.orange, bgcolor=color.black)
    table.cell(info, 0, 1, "No verified 70-80% win rate. Each chart is a separate simulation.", text_color=color.white, bgcolor=color.black)
